# Portable SSH defaults. Tracked by yadm.
#
# Per-machine hosts, jumphosts and identities live in ~/.ssh/conf.d/*.conf,
# which is ignored -- this repo is public and each laptop has its own keys.
#
# Include comes FIRST on purpose: ssh takes the first value it sees for each
# keyword, so specific host blocks must be read before the `Host *` defaults.

Include ~/.ssh/conf.d/*.conf

Host *
    SetEnv TERM=xterm
    AddKeysToAgent yes
    UseKeychain yes
    WarnWeakCrypto no
    ServerAliveInterval 60
    ServerAliveCountMax 3
    HashKnownHosts no
