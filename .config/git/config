# Tracked, portable git configuration. Machine- and employer-specific values
# (identity, internal hosts, per-client includeIf rules) live in config.local,
# which is ignored by yadm so the work and personal laptops never share them.

[include]
	path = config.local

[init]
	defaultBranch = main

[core]
	editor = nvim
	# ~/.config/git/ignore is picked up automatically as the XDG default.

[push]
	autoSetupRemote = true
[pull]
	rebase = true
[fetch]
	prune = true
[rebase]
	autoStash = true
	autoSquash = true

[diff]
	colorMoved = default
	algorithm = histogram
[diff "sopsdiffer"]
	textconv = sops -d

# git-delta is in the Brewfile but was never wired up.
[pager]
	diff = delta
	log = delta
	reflog = delta
	show = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	line-numbers = true
[merge]
	conflictStyle = zdiff3

[rerere]
	enabled = true
[column]
	ui = auto
[branch]
	sort = -committerdate
